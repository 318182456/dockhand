# syntax=docker/dockerfile:1.4
# =============================================================================
# Dockhand 国内镜像加速 overlay 镜像
# 基于上游官方镜像 fnsys/dockhand,构建期注入镜像加速及进度显示补丁。
# 不合并上游源码、不自行编译前端 —— 上游怎么发版,这里只做一层轻量补丁。
# =============================================================================
ARG UPSTREAM_VERSION=latest

FROM fnsys/dockhand:${UPSTREAM_VERSION} AS official

# -----------------------------------------------------------------------------
# 注入阶段:包装镜像拉取与 Stack 预拉取
# -----------------------------------------------------------------------------
FROM node:24-slim AS patcher
COPY --from=official /app/build /build
COPY scripts/zh-runtime/registry-mirror.template.js /zh/registry-mirror.template.js
COPY scripts/zh-runtime/inject.mjs /zh/inject.mjs
COPY scripts/zh-runtime/pull-progress.template.js /zh/pull-progress.template.js
COPY scripts/zh-runtime/default-template.mjs scripts/zh-runtime/default-template.test.mjs /zh/
RUN node --test /zh/default-template.test.mjs
RUN node /zh/inject.mjs /build /zh
COPY --from=official /app/node_modules/js-yaml /zh/node_modules/js-yaml
COPY scripts/zh-runtime/validation-env.mjs scripts/zh-runtime/validation-env.template.js scripts/zh-runtime/validation-env.test.mjs /zh/
RUN node --test /zh/validation-env.test.mjs
RUN node /zh/validation-env.mjs /build /zh/validation-env.template.js

# -----------------------------------------------------------------------------
# 最终镜像:官方镜像原样 + 打过补丁的 build 产物(属主与上游一致 1001:1001)
# -----------------------------------------------------------------------------
FROM fnsys/dockhand:${UPSTREAM_VERSION}
COPY --from=patcher --chown=1001:1001 /build /app/build
